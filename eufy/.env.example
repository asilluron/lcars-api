# Copy this file to .env and fill it in. .env is gitignored.
# The password stays in that file. Do not pass it on the docker run command line.

EUFY_EMAIL=you@example.com
EUFY_PASSWORD=replace-me
EUFY_COUNTRY=US

# 127.0.0.1 keeps the proxy on this machine. In Docker, use 0.0.0.0:3000
# so the published port is reachable.
EUFY_LISTEN=127.0.0.1:3000

# Directory for the saved login (session.json) and a captcha image.
# EUFY_SESSION_DIR=

# Load this file instead of the .env next to the program.
# EUFY_ENV_FILE=
